---
import { ClientRouter } from "astro:transitions";
import { menuLinks, siteConfig } from "@/site.config";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${siteConfig.author} · Cloud Architect`,
	description = siteConfig.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={siteConfig.lang} class="light" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />

		<script is:inline>
			const storedTheme = localStorage.getItem("theme");
			if (storedTheme === "dark") {
				document.documentElement.classList.remove("light");
				document.documentElement.classList.add("dark");
			}
		</script>

		<style is:global>
			:root {
				--font-display: "Space Grotesk", sans-serif;
				--font-sans: "DM Sans", sans-serif;
				--font-mono: "JetBrains Mono", monospace;
				--bg: #f7f1e8;
				--bg-soft: #efe6db;
				--surface: rgba(255, 252, 247, 0.84);
				--surface-strong: #fffaf4;
				--surface-alt: #f3e6d5;
				--border: rgba(102, 70, 38, 0.12);
				--border-strong: rgba(102, 70, 38, 0.2);
				--text: #24170f;
				--text-soft: #5f4a3a;
				--muted: #7d6551;
				--accent: #eb6b4a;
				--accent-strong: #c94c2b;
				--accent-alt: #5d84ff;
				--accent-alt-soft: rgba(93, 132, 255, 0.14);
				--accent-mint: #2f9b83;
				--accent-mint-soft: rgba(47, 155, 131, 0.14);
				--accent-soft: rgba(235, 107, 74, 0.14);
				--accent-glow: rgba(235, 107, 74, 0.28);
				--shadow: 0 22px 60px rgba(69, 39, 18, 0.12);
				--shadow-soft: 0 12px 32px rgba(69, 39, 18, 0.08);
				--radius-lg: 32px;
				--radius-md: 22px;
				--radius-sm: 14px;
				--max-width: 1120px;
			}

			html.dark {
				--bg: #0f1320;
				--bg-soft: #171d2d;
				--surface: rgba(18, 25, 39, 0.84);
				--surface-strong: #151c2b;
				--surface-alt: #1d2639;
				--border: rgba(151, 173, 214, 0.12);
				--border-strong: rgba(151, 173, 214, 0.24);
				--text: #f8f3ee;
				--text-soft: #c9cad4;
				--muted: #9ca7be;
				--accent: #f5a46d;
				--accent-strong: #ffbf8d;
				--accent-alt: #8cabff;
				--accent-alt-soft: rgba(140, 171, 255, 0.16);
				--accent-mint: #78d0ba;
				--accent-mint-soft: rgba(120, 208, 186, 0.12);
				--accent-soft: rgba(245, 164, 109, 0.14);
				--accent-glow: rgba(245, 164, 109, 0.22);
				--shadow: 0 26px 64px rgba(0, 0, 0, 0.36);
				--shadow-soft: 0 16px 40px rgba(0, 0, 0, 0.22);
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				min-height: 100vh;
				font-family: var(--font-sans);
				background:
					radial-gradient(circle at top left, var(--accent-soft), transparent 28%),
					radial-gradient(circle at top right, rgba(116, 159, 255, 0.12), transparent 26%),
					linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
				color: var(--text);
				line-height: 1.75;
			}

			a {
				color: inherit;
			}

			img {
				display: block;
				max-width: 100%;
			}

			.site-shell {
				position: relative;
				overflow: hidden;
			}

			.page-noise {
				position: fixed;
				inset: 0;
				pointer-events: none;
				background-image:
					linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
				background-size: 42px 42px;
				mask-image: radial-gradient(circle at center, black 30%, transparent 90%);
				opacity: 0.2;
			}

			.container {
				width: min(calc(100% - 2rem), var(--max-width));
				margin: 0 auto;
			}

			.site-header {
				position: sticky;
				top: 0;
				z-index: 30;
				padding: 1.25rem 0 0;
			}

			.site-header-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem 1.2rem;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: color-mix(in srgb, var(--surface) 88%, transparent);
				backdrop-filter: blur(18px);
				box-shadow: var(--shadow-soft);
			}

			.site-brand {
				display: inline-flex;
				flex-direction: column;
				text-decoration: none;
				color: var(--text);
				min-width: max-content;
			}

			.site-brand-mark {
				font-family: var(--font-mono);
				font-size: 0.73rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.site-brand-name {
				font-family: var(--font-display);
				font-size: 1.05rem;
				font-weight: 700;
				letter-spacing: -0.03em;
			}

			.site-nav {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				flex-wrap: wrap;
				justify-content: flex-end;
				position: relative;
				isolation: isolate;
			}

			.nav-indicator {
				position: absolute;
				top: 0;
				left: 0;
				border-radius: 999px;
				background: var(--surface-strong);
				border: 1px solid var(--border-strong);
				box-shadow: var(--shadow-soft);
				opacity: 0;
				transition:
					transform 0.34s cubic-bezier(0.22, 1, 0.36, 1),
					width 0.34s cubic-bezier(0.22, 1, 0.36, 1),
					height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
					opacity 0.2s ease;
				z-index: 0;
			}

			.nav-link,
			.theme-toggle {
				border: 1px solid transparent;
				border-radius: 999px;
				padding: 0.65rem 0.95rem;
				font-size: 0.92rem;
				text-decoration: none;
				color: var(--text-soft);
				background: transparent;
				transition:
					background-color 0.2s ease,
					border-color 0.2s ease,
					color 0.2s ease,
					transform 0.2s ease;
				position: relative;
				z-index: 1;
			}

			.nav-link:hover,
			.nav-link.nav-active,
			.theme-toggle:hover {
				color: var(--text);
				background: var(--surface-strong);
				border-color: var(--border-strong);
				transform: translateY(-1px);
			}

			.theme-toggle {
				cursor: pointer;
				font-family: var(--font-mono);
			}

			.site-main {
				padding: 2.5rem 0 4rem;
			}

			.page-stack {
				display: grid;
				gap: 2rem;
			}

			.section-card,
			.article-card,
			.hero-card,
			.feature-card,
			.cta-card {
				position: relative;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: var(--surface);
				box-shadow: var(--shadow);
				backdrop-filter: blur(14px);
			}

			.section-card,
			.article-card,
			.feature-card,
			.cta-card {
				padding: 1.7rem;
			}

			.hero-card {
				padding: 2.2rem;
				overflow: hidden;
				background:
					linear-gradient(135deg, color-mix(in srgb, var(--surface) 92%, transparent), color-mix(in srgb, var(--surface-alt) 74%, transparent)),
					var(--surface);
			}

			.hero-card::before,
			.hero-card::after,
			.section-card::before,
			.cta-card::before {
				content: "";
				position: absolute;
				pointer-events: none;
			}

			.hero-card::before {
				width: 18rem;
				height: 18rem;
				right: -6rem;
				top: -5rem;
				background: radial-gradient(circle, var(--accent-glow), transparent 72%);
			}

			.hero-card::after {
				width: 12rem;
				height: 12rem;
				left: -4rem;
				bottom: -4rem;
				background: radial-gradient(circle, rgba(116, 159, 255, 0.2), transparent 72%);
			}

			.section-card::before,
			.cta-card::before {
				inset: 1px;
				border-radius: inherit;
				border: 1px solid rgba(255, 255, 255, 0.08);
				opacity: 0.45;
			}

			.tone-sunset {
				background:
					linear-gradient(150deg, color-mix(in srgb, var(--accent-soft) 90%, var(--surface) 10%), color-mix(in srgb, var(--surface) 82%, transparent));
			}

			.tone-sky {
				background:
					linear-gradient(145deg, color-mix(in srgb, var(--accent-alt-soft) 88%, var(--surface) 12%), color-mix(in srgb, var(--surface) 82%, transparent));
			}

			.tone-mint {
				background:
					linear-gradient(145deg, color-mix(in srgb, var(--accent-mint-soft) 84%, var(--surface) 16%), color-mix(in srgb, var(--surface) 86%, transparent));
			}

			.tone-ink {
				background:
					linear-gradient(145deg, color-mix(in srgb, #1d2740 92%, transparent), color-mix(in srgb, #24314f 84%, transparent));
				border-color: color-mix(in srgb, var(--accent-alt) 18%, var(--border));
			}

			.tone-ink .section-title,
			.tone-ink .section-copy,
			.tone-ink .eyebrow,
			.tone-ink .story-link,
			.tone-ink .card-title,
			.tone-ink .card-description,
			.tone-ink .card-meta {
				color: #eef3ff;
			}

			.tone-ink .section-copy,
			.tone-ink .card-description,
			.tone-ink .card-meta {
				color: #bcc8e2;
			}

			.tone-ink .eyebrow {
				color: #ffd0ad;
			}

			.tone-ink .eyebrow::before {
				background: currentColor;
			}

			.hero-layout,
			.two-column {
				display: grid;
				gap: 1.5rem;
			}

			.hero-layout {
				grid-template-columns: minmax(0, 1.22fr) minmax(340px, 0.88fr);
				gap: 2rem;
				align-items: start;
			}

			.two-column {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				margin-bottom: 1rem;
				font-family: var(--font-mono);
				font-size: 0.74rem;
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--accent-strong);
			}

			.eyebrow::before {
				content: "";
				display: inline-block;
				width: 2.6rem;
				height: 1px;
				background: currentColor;
				opacity: 0.5;
			}

			.hero-title,
			.page-title,
			.article-title {
				font-family: var(--font-display);
				font-weight: 700;
				letter-spacing: -0.05em;
				line-height: 0.98;
			}

			.hero-title {
				font-size: clamp(2.8rem, 6vw, 5.3rem);
				max-width: 12ch;
			}

			.page-title,
			.article-title {
				font-size: clamp(2rem, 5vw, 3.6rem);
			}

			.accent-text {
				color: var(--accent-strong);
			}

			.lead,
			.section-copy,
			.page-copy {
				color: var(--text-soft);
				font-size: 1.02rem;
			}

			.lead {
				max-width: 52ch;
				margin-top: 1rem;
				font-size: 1.08rem;
			}

			.hero-actions,
			.inline-actions,
			.meta-row,
			.tag-list,
			.social-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.9rem;
				align-items: center;
			}

			.hero-actions {
				margin-top: 1.4rem;
				gap: 0.8rem 1rem;
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.55rem;
				border-radius: 999px;
				padding: 0.92rem 1.25rem;
				border: 1px solid transparent;
				background: var(--accent);
				color: #fff8f2;
				font-weight: 700;
				text-decoration: none;
				box-shadow: 0 12px 30px color-mix(in srgb, var(--accent) 28%, transparent);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					background-color 0.2s ease;
			}

			.button:hover {
				transform: translateY(-2px);
				background: var(--accent-strong);
				box-shadow: 0 16px 34px color-mix(in srgb, var(--accent) 34%, transparent);
			}

			.button.secondary {
				background: var(--surface-strong);
				color: var(--text);
				border-color: var(--border-strong);
				box-shadow: none;
			}

			.button.quiet {
				padding: 0;
				border: 0;
				border-radius: 0;
				background: transparent;
				box-shadow: none;
				color: var(--text-soft);
				font-weight: 600;
			}

			.button.quiet:hover {
				transform: none;
				background: transparent;
				box-shadow: none;
				color: var(--accent-strong);
			}

			.hero-note,
			.meta-pill,
			.tag,
			.skill-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.5rem 0.8rem;
				border-radius: 999px;
				background: var(--surface-strong);
				border: 1px solid var(--border);
				font-size: 0.78rem;
				color: var(--text-soft);
			}

			.tag {
				text-decoration: none;
			}

			.tag-link {
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					background-color 0.2s ease,
					color 0.2s ease;
			}

			.tag-link:hover {
				transform: translateY(-2px);
				border-color: var(--border-strong);
				background: color-mix(in srgb, var(--accent-soft) 72%, var(--surface-strong) 28%);
				color: var(--text);
			}

			.tag-count {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--muted);
			}

			.tag-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
			}

			.tag-card {
				display: grid;
				gap: 0.8rem;
				padding: 1.3rem;
				border-radius: var(--radius-md);
				border: 1px solid var(--border);
				background: var(--surface-strong);
				box-shadow: var(--shadow-soft);
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.tag-card:hover {
				transform: translateY(-3px);
				border-color: var(--border-strong);
				box-shadow: var(--shadow);
			}

			.tag-card-title {
				font-family: var(--font-display);
				font-size: 1.2rem;
				letter-spacing: -0.03em;
				color: var(--text);
			}

			.tag-card-meta {
				color: var(--text-soft);
			}

			.hero-note {
				margin-top: 1.2rem;
			}

			.hero-copy {
				display: grid;
				align-content: start;
				padding-right: 1rem;
			}

			.hero-support {
				display: grid;
				gap: 0.5rem;
				margin-top: 1rem;
				max-width: 38ch;
			}

			.hero-support-title {
				font-family: var(--font-display);
				font-size: 1.25rem;
				font-weight: 700;
				letter-spacing: -0.03em;
				line-height: 1.15;
				color: var(--text);
			}

			.hero-support-copy {
				color: var(--text-soft);
				font-size: 1.02rem;
			}

			.hero-socials {
				margin-top: 1.15rem;
			}

			.hero-socials .social-list {
				gap: 0.6rem;
			}

			.hero-metrics {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.9rem;
				margin-top: 1.5rem;
			}

			.metric-card {
				display: grid;
				gap: 0.2rem;
				padding: 0.95rem 1rem;
				border-radius: 18px;
				border: 1px solid var(--border);
				background: color-mix(in srgb, var(--surface-strong) 92%, transparent);
				box-shadow: var(--shadow-soft);
			}

			.metric-value {
				font-family: var(--font-display);
				font-size: 1.55rem;
				letter-spacing: -0.04em;
				color: var(--text);
			}

			.metric-label {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--muted);
			}

			.hero-visual {
				display: grid;
				gap: 1rem;
				align-self: start;
				width: 100%;
				max-width: 520px;
				justify-self: end;
			}

			.hero-media-frame {
				position: relative;
				padding: 0.75rem;
				border-radius: 24px;
				background:
					linear-gradient(145deg, color-mix(in srgb, var(--surface-strong) 88%, transparent), color-mix(in srgb, var(--surface-alt) 86%, transparent));
				border: 1px solid var(--border-strong);
				box-shadow: var(--shadow-soft);
			}

			.hero-media-frame::before {
				content: "";
				position: absolute;
				inset: auto 1rem 1rem auto;
				width: 7rem;
				height: 7rem;
				border-radius: 50%;
				background: radial-gradient(circle, var(--accent-glow), transparent 68%);
				filter: blur(12px);
			}

			.hero-media {
				position: relative;
				overflow: hidden;
				border-radius: 18px;
				border: 1px solid var(--border);
				background: linear-gradient(180deg, #fff6eb 0%, #eddcc6 100%);
				aspect-ratio: 1408 / 768;
			}

			html.dark .hero-media {
				background: linear-gradient(180deg, #1a2130 0%, #141b29 100%);
			}

			.hero-media img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}

			.hero-floating-card {
				display: grid;
				gap: 0.35rem;
				justify-self: end;
				width: min(100%, 270px);
				padding: 1rem 1.05rem;
				border-radius: 20px;
				background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
				border: 1px solid var(--border);
				box-shadow: var(--shadow-soft);
			}

			.hero-floating-card.alt {
				justify-self: start;
				width: min(100%, 220px);
				background: color-mix(in srgb, var(--accent-alt-soft) 72%, var(--surface-strong) 28%);
			}

			.hero-floating-card strong,
			.section-title,
			.story-title,
			.card-title,
			.footer-title {
				font-family: var(--font-display);
				letter-spacing: -0.03em;
			}

			.section-head,
			.page-hero {
				display: grid;
				gap: 0.65rem;
			}

			.section-title {
				font-size: clamp(1.6rem, 3vw, 2.2rem);
			}

			.story-list,
			.card-list,
			.icon-list {
				list-style: none;
				display: grid;
				gap: 1rem;
			}

			.story-card,
			.note-card,
			.mini-card {
				display: grid;
				gap: 0.85rem;
				padding: 1.3rem;
				border-radius: var(--radius-md);
				border: 1px solid var(--border);
				background: var(--surface-strong);
				box-shadow: var(--shadow-soft);
				text-decoration: none;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease,
					box-shadow 0.2s ease;
			}

			.story-card {
				position: relative;
				overflow: hidden;
			}

			.story-card::before,
			.note-card::before {
				content: "";
				position: absolute;
				inset: 0 auto 0 0;
				width: 4px;
				background: linear-gradient(180deg, var(--accent), var(--accent-alt));
			}

			.story-list li:nth-child(2n) .story-card {
				background: linear-gradient(145deg, color-mix(in srgb, var(--accent-alt-soft) 72%, var(--surface-strong) 28%), var(--surface-strong));
			}

			.story-list li:nth-child(3n) .story-card {
				background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 70%, var(--surface-strong) 30%), var(--surface-strong));
			}

			.note-card {
				background: linear-gradient(145deg, color-mix(in srgb, var(--accent-mint-soft) 80%, var(--surface-strong) 20%), var(--surface-strong));
			}

			.card-badge {
				display: inline-flex;
				align-items: center;
				justify-self: start;
				padding: 0.28rem 0.62rem;
				border-radius: 999px;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: rgba(255, 255, 255, 0.42);
				border: 1px solid var(--border);
				color: var(--text-soft);
			}

			.story-card:hover,
			.note-card:hover,
			.mini-card:hover {
				transform: translateY(-3px);
				border-color: var(--border-strong);
				box-shadow: var(--shadow);
			}

			.card-content-link {
				display: grid;
				gap: 0.85rem;
				text-decoration: none;
				color: inherit;
			}

			.story-meta,
			.card-meta,
			.footer-meta,
			.kicker {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--muted);
			}

			.story-title,
			.card-title {
				font-size: 1.25rem;
				line-height: 1.15;
				color: var(--text);
			}

			.story-description,
			.card-description,
			.footer-copy {
				color: var(--text-soft);
			}

			.story-link {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				color: var(--accent-strong);
				font-weight: 700;
				text-decoration: none;
			}

			.page-grid {
				display: grid;
				gap: 1.4rem;
			}

			.article-shell {
				display: grid;
				gap: 1.3rem;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--muted);
				text-decoration: none;
			}

			.back-link:hover {
				color: var(--accent-strong);
			}

			.article-card {
				padding: 2rem;
			}

			.article-header {
				display: grid;
				gap: 1rem;
				margin-bottom: 1.75rem;
			}

			.meta-row {
				gap: 0.6rem;
			}

			.prose {
				font-size: 1.04rem;
				line-height: 1.9;
				color: var(--text-soft);
			}

			.prose > * + * {
				margin-top: 1.2rem;
			}

			.prose h2,
			.prose h3,
			.prose h4 {
				font-family: var(--font-display);
				color: var(--text);
				line-height: 1.1;
				letter-spacing: -0.03em;
			}

			.prose h2 {
				font-size: 1.95rem;
				margin-top: 2.4rem;
			}

			.prose h3 {
				font-size: 1.45rem;
				margin-top: 2rem;
			}

			.prose a {
				color: var(--accent-strong);
				text-decoration-thickness: 0.08em;
				text-underline-offset: 0.16em;
			}

			.prose strong {
				color: var(--text);
			}

			.prose ul,
			.prose ol {
				padding-left: 1.35rem;
			}

			.prose li + li {
				margin-top: 0.4rem;
			}

			.prose blockquote {
				padding: 1.1rem 1.2rem;
				border-left: 3px solid var(--accent);
				background: var(--surface-strong);
				border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
				color: var(--text-soft);
			}

			.prose code {
				font-family: var(--font-mono);
				font-size: 0.88em;
				padding: 0.14rem 0.42rem;
				background: var(--surface-alt);
				border: 1px solid var(--border);
				border-radius: 8px;
			}

			.prose pre {
				padding: 1.1rem;
				background: var(--surface-alt);
				border: 1px solid var(--border);
				border-radius: var(--radius-md);
				overflow-x: auto;
				box-shadow: var(--shadow-soft);
			}

			.prose pre code {
				padding: 0;
				border: 0;
				background: transparent;
			}

			.prose hr {
				border: 0;
				border-top: 1px solid var(--border);
				margin: 2rem 0;
			}

			.prose table {
				width: 100%;
				border-collapse: collapse;
			}

			.prose th,
			.prose td {
				padding: 0.8rem 0.9rem;
				border-bottom: 1px solid var(--border);
				text-align: left;
			}

			.prose th {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--muted);
			}

			.skill-cloud {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.skill-pill {
				font-size: 0.84rem;
			}

			.timeline {
				display: grid;
				gap: 1rem;
			}

			.timeline-card {
				padding: 1.2rem 1.25rem;
				border-radius: var(--radius-md);
				border: 1px solid var(--border);
				background: var(--surface-strong);
				box-shadow: var(--shadow-soft);
			}

			.timeline-head {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.45rem;
			}

			.timeline-role {
				font-family: var(--font-display);
				font-size: 1.2rem;
				line-height: 1.15;
			}

			.timeline-company {
				color: var(--accent-strong);
				font-weight: 700;
			}

			.timeline-list {
				padding-left: 1.2rem;
				color: var(--text-soft);
			}

			.timeline-list li + li {
				margin-top: 0.35rem;
			}

			.cta-card {
				display: grid;
				gap: 1rem;
				align-items: center;
				background:
					linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 72%, var(--surface) 28%), color-mix(in srgb, var(--accent-alt-soft) 56%, var(--surface) 44%));
			}

			.asymmetric-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
				gap: 1.5rem;
				align-items: stretch;
			}

			.site-footer {
				padding: 0 0 2rem;
			}

			.footer-card {
				display: grid;
				gap: 1.3rem;
				grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
				padding: 1.6rem 1.7rem;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: color-mix(in srgb, var(--surface) 92%, transparent);
				box-shadow: var(--shadow-soft);
			}

			.footer-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem 1rem;
				justify-content: flex-end;
				align-items: flex-start;
			}

			.footer-links a {
				color: var(--text-soft);
				text-decoration: none;
			}

			.footer-links a:hover {
				color: var(--accent-strong);
			}

			.empty-state {
				text-align: center;
				padding: 3rem 1.5rem;
			}

			@media (max-width: 920px) {
				.hero-layout,
				.two-column,
				.footer-card,
				.asymmetric-grid {
					grid-template-columns: 1fr;
				}

				.hero-card,
				.section-card,
				.article-card,
				.cta-card {
					padding: 1.45rem;
				}

				.hero-copy {
					padding-right: 0;
				}

				.hero-visual {
					max-width: 100%;
					justify-self: stretch;
				}

				.footer-links {
					justify-content: flex-start;
				}
			}

			@media (max-width: 720px) {
				.site-header-inner {
					border-radius: 28px;
				}

				.site-nav {
					width: 100%;
					justify-content: flex-start;
				}

				.hero-media {
					aspect-ratio: 1408 / 768;
				}

				.hero-metrics {
					grid-template-columns: 1fr;
				}

				.hero-title {
					max-width: none;
				}

				.hero-actions {
					gap: 0.75rem;
				}
			}

			@media (max-width: 560px) {
				.container {
					width: min(calc(100% - 1.2rem), var(--max-width));
				}

				.site-main {
					padding: 1.5rem 0 3rem;
				}

				.site-header {
					padding-top: 0.7rem;
				}

				.site-header-inner {
					padding: 0.95rem;
				}

				.nav-link,
				.theme-toggle {
					padding: 0.6rem 0.8rem;
				}

				.hero-card,
				.section-card,
				.article-card,
				.cta-card {
					border-radius: 24px;
				}
			}
		</style>
	</head>
	<body>
		<div class="site-shell">
			<div class="page-noise"></div>
			<header class="site-header">
				<div class="container">
					<div class="site-header-inner" transition:persist="site-header">
						<a class="site-brand" href="/">
							<span class="site-brand-mark">Cloud architect</span>
							<span class="site-brand-name">{siteConfig.author}</span>
						</a>

						<nav class="site-nav" aria-label="Main navigation" data-site-nav>
							<span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
							{menuLinks.map(({ link, title }) => (
								<a
									href={link}
									data-nav-link
									data-route={link}
									class:list={[
										"nav-link",
										{ "nav-active": Astro.url.pathname === link || (link !== "/" && Astro.url.pathname.startsWith(link)) },
									]}
									aria-current={Astro.url.pathname === link || (link !== "/" && Astro.url.pathname.startsWith(link)) ? "page" : undefined}
								>
									{title}
								</a>
							))}
							<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
								theme
							</button>
						</nav>
					</div>
				</div>
			</header>

			<main class="site-main" transition:name="site-main" transition:animate="slide">
				<div class="container page-stack">
					<slot />
				</div>
			</main>

			<footer class="site-footer" transition:persist="site-footer">
				<div class="container">
					<div class="footer-card">
						<div class="page-stack" style="gap: 0.5rem;">
							<p class="eyebrow">Built for writing and shipping</p>
							<p class="footer-title" style="font-size: 1.65rem;">Architecture notes, migration lessons, and the experiments between them.</p>
							<p class="footer-copy">
								I write about OCI, enterprise systems, cloud migration patterns, and the practical bits that help teams move faster.
							</p>
							<p class="footer-meta">© {currentYear} {siteConfig.author} · Austin, TX</p>
						</div>
						<div class="footer-links">
							<a href="/posts/">Blog</a>
							<a href="/til/">TIL</a>
							<a href="/tags/">Tags</a>
							<a href="/about/">About</a>
							<a href="/rss.xml">RSS</a>
							<a href="https://github.com/shivangpandya" target="_blank" rel="noopener noreferrer">GitHub</a>
							<a href="https://www.linkedin.com/in/shivangpandya" target="_blank" rel="noopener noreferrer">LinkedIn</a>
						</div>
					</div>
				</div>
			</footer>
		</div>

		<script is:inline>
			const root = document.documentElement;

			const applyStoredTheme = () => {
				const storedTheme = localStorage.getItem("theme");
				const isDark = storedTheme === "dark";

				root.classList.toggle("dark", isDark);
				root.classList.toggle("light", !isDark);
			};

			const syncThemeToggle = () => {
				const toggle = document.getElementById("theme-toggle");
				if (!toggle) {
					return;
				}

				toggle.setAttribute("aria-pressed", String(root.classList.contains("dark")));

				if (toggle.dataset.bound === "true") {
					return;
				}

				toggle.dataset.bound = "true";
				toggle.addEventListener("click", () => {
					const isDark = root.classList.contains("dark");
					root.classList.toggle("dark", !isDark);
					root.classList.toggle("light", isDark);
					localStorage.setItem("theme", isDark ? "light" : "dark");
					toggle.setAttribute("aria-pressed", String(!isDark));
				});
			};

			const isActiveRoute = (pathname, route) =>
				pathname === route || (route !== "/" && pathname.startsWith(route));

			const syncNavState = () => {
				const nav = document.querySelector("[data-site-nav]");
				if (!nav) {
					return;
				}

				const links = [...nav.querySelectorAll("[data-nav-link]")];
				const indicator = nav.querySelector("[data-nav-indicator]");
				const pathname = window.location.pathname;
				let activeLink = null;

				for (const link of links) {
					const route = link.getAttribute("data-route") ?? "";
					const isActive = isActiveRoute(pathname, route);

					link.classList.toggle("nav-active", isActive);

					if (isActive) {
						link.setAttribute("aria-current", "page");
						activeLink = link;
					} else {
						link.removeAttribute("aria-current");
					}
				}

				if (!indicator || !activeLink) {
					return;
				}

				const navRect = nav.getBoundingClientRect();
				const linkRect = activeLink.getBoundingClientRect();

				indicator.style.width = `${linkRect.width}px`;
				indicator.style.height = `${linkRect.height}px`;
				indicator.style.transform = `translate(${linkRect.left - navRect.left}px, ${linkRect.top - navRect.top}px)`;
				indicator.style.opacity = "1";
			};

			const mountSiteShell = () => {
				applyStoredTheme();
				syncThemeToggle();
				syncNavState();
			};

			if (!window.__siteShellEventsBound) {
				window.__siteShellEventsBound = true;
				window.addEventListener("resize", syncNavState);
				document.addEventListener("astro:after-swap", applyStoredTheme);
				document.addEventListener("astro:page-load", mountSiteShell);
			}

			mountSiteShell();
		</script>
	</body>
</html>
