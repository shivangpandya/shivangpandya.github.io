---
import { Icon } from "astro-icon/components";

interface Props {
	variant?: "pill" | "card";
}

const { variant = "pill" } = Astro.props;

const socials = [
	{
		href: "https://github.com/shivangpandya",
		label: "GitHub",
		icon: "tabler:brand-github",
		description: "Code, projects, and public repos.",
	},
	{
		href: "https://www.linkedin.com/in/shivangpandya",
		label: "LinkedIn",
		icon: "tabler:brand-linkedin",
		description: "Career updates and professional profile.",
	},
	{
		href: "https://substack.com/@shivangpandya1/notes?utm_campaign=profile&utm_medium=profile-page",
		label: "Substack",
		icon: "tabler:book-2",
		description: "Notes, writing, and longer-form thinking.",
	},
	{
		href: "mailto:shivang.pandya01@gmail.com",
		label: "Email",
		icon: "tabler:mail",
		description: "Best for direct conversations.",
	},
];
---

{
	variant === "card" ? (
		<div class="social-grid">
			{socials.map(({ href, label, icon, description }) => (
				<a
					class="social-card"
					href={href}
					target={href.startsWith("mailto:") ? undefined : "_blank"}
					rel={href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
				>
					<span class="social-card-icon">
						<Icon name={icon} />
					</span>
					<div class="social-card-copy">
						<span class="social-card-title">{label}</span>
						<span class="social-card-description">{description}</span>
					</div>
					<span class="social-card-arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	) : (
		<div class="social-list">
			{socials.map(({ href, label, icon }) => (
				<a
					class="social-pill meta-pill"
					href={href}
					target={href.startsWith("mailto:") ? undefined : "_blank"}
					rel={href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
				>
					<Icon name={icon} />
					{label}
				</a>
			))}
		</div>
	)
}

<style>
	.social-pill {
		text-decoration: none;
	}

	.social-pill :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.social-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.social-card {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.05rem;
		border-radius: 20px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
		box-shadow: var(--shadow-soft);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}

	.social-card:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
		background: color-mix(in srgb, var(--surface-strong) 94%, var(--accent-soft) 6%);
	}

	.social-card-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.7rem;
		height: 2.7rem;
		border-radius: 16px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface-alt) 76%, transparent);
		color: var(--accent-strong);
	}

	.social-card-icon :global(svg) {
		width: 1.35rem;
		height: 1.35rem;
	}

	.social-card-copy {
		display: grid;
		gap: 0.18rem;
	}

	.social-card-title {
		font-family: var(--font-display);
		font-size: 1.05rem;
		letter-spacing: -0.03em;
		color: var(--text);
	}

	.social-card-description {
		font-size: 0.92rem;
		line-height: 1.45;
		color: var(--text-soft);
	}

	.social-card-arrow {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.social-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
