---
import type { CollectionEntry } from "astro:content";
import { getEntryTags, getTagHref } from "@/utils/tags";

interface Props {
	note: CollectionEntry<"note">;
}

const { note } = Astro.props;

const dateFormatted = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
}).format(note.data.publishDate);

const tags = getEntryTags(note);
---

<li>
	<article class="note-card">
		<a class="card-content-link" href={`/til/${note.id}/`}>
			<span class="card-badge">TIL</span>
			<div class="card-meta">{dateFormatted}</div>
			<h3 class="card-title">{note.data.title}</h3>
			{note.data.description && <p class="card-description">{note.data.description}</p>}
			<span class="story-link">Open note <span aria-hidden="true">→</span></span>
		</a>
		{tags.length > 0 && (
			<div class="tag-list">
				{tags.map((tag) => (
					<a class="tag tag-link" href={getTagHref(tag)}>
						#{tag}
					</a>
				))}
			</div>
		)}
	</article>
</li>
