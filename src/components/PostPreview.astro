---
import type { CollectionEntry } from "astro:content";
import { getEntryTags, getTagHref } from "@/utils/tags";

interface Props {
	post: CollectionEntry<"post">;
	as?: "h2" | "h3";
}

const { post, as: Tag = "h3" } = Astro.props;

const dateFormatted = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
}).format(post.data.publishDate);

const tags = getEntryTags(post);
---

<li>
	<article class="story-card">
		<a class="card-content-link" href={`/posts/${post.id}/`}>
			<span class="card-badge">Blog</span>
			<div class="story-meta">{dateFormatted}</div>
			<Tag class="story-title">{post.data.title}</Tag>
			<p class="story-description">{post.data.description}</p>
			<span class="story-link">Read post <span aria-hidden="true">→</span></span>
		</a>
		{tags.length > 0 && (
			<div class="tag-list">
				{tags.map((tag) => (
					<a class="tag tag-link" href={getTagHref(tag)}>
						#{tag}
					</a>
				))}
			</div>
		)}
	</article>
</li>
