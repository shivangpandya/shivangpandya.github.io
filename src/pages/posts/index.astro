---
import { getCollection } from "astro:content";
import PostPreview from "@/components/PostPreview.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { collectTagSummaries, sortEntriesByPublishDateDesc } from "@/utils/tags";

const allPosts = sortEntriesByPublishDateDesc(
	await getCollection("post", ({ data }) => !data.draft),
);
const tagSummaries = collectTagSummaries(allPosts, []).slice(0, 10);
---

<BaseLayout
	title="Blog · Shivang Pandya"
	description="Thoughts on cloud architecture, OCI, AWS, enterprise migrations, and building things."
>
	<section class="section-card tone-sky">
		<div class="page-hero">
			<p class="eyebrow">Archive</p>
			<h1 class="page-title">Blog</h1>
			<p class="page-copy">
				Long-form writing on cloud architecture, enterprise migration work, integration patterns, and systems that need to survive contact with reality.
			</p>
		</div>

		{tagSummaries.length > 0 && (
			<div style="margin-top: 1.4rem;">
				<div class="tag-list">
					{tagSummaries.map((tag) => (
						<a class="tag tag-link" href={`/tags/${tag.slug}/`}>
							#{tag.label}
							<span class="tag-count">{tag.count}</span>
						</a>
					))}
					<a class="tag tag-link" href="/tags/">Browse all tags</a>
				</div>
			</div>
		)}
	</section>

	<section class="section-card tone-sunset">
		<ul class="story-list" role="list">
			{allPosts.map((post) => <PostPreview post={post} as="h2" />)}
		</ul>
	</section>
</BaseLayout>
