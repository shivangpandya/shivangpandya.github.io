---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostPreview from "@/components/PostPreview.astro";

const allPosts = await getCollection("post", ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
	title="Blog · Shivang Pandya"
	description="Thoughts on cloud architecture, OCI, AWS, enterprise migrations, and building things."
>
	<h1 class="title mb-2 text-2xl">Blog</h1>
	<p class="mb-10 text-muted-foreground text-sm">
		Thoughts on cloud architecture, OCI, AWS, enterprise migrations, and building things.
	</p>
	<ul class="space-y-6" role="list">
		{allPosts.map((post) => <PostPreview post={post} as="h2" />)}
	</ul>
</BaseLayout>
