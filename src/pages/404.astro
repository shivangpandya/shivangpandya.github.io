---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 · Not Found" description="Page not found.">
	<div style="text-align: center; padding: 4rem 0;">
		<p style="font-size: 4rem; font-weight: 600; color: var(--accent); margin-bottom: 1rem;">404</p>
		<p style="color: var(--muted); margin-bottom: 2rem;">This page doesn't exist.</p>
		<a href="/" style="font-size: 0.85rem;">← go home</a>
	</div>
</BaseLayout>
