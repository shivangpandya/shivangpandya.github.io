---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEntryTags, getTagHref } from "@/utils/tags";

export async function getStaticPaths() {
	const notes = await getCollection("note", ({ data }) => !data.draft);
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);

const dateFormatted = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
}).format(note.data.publishDate);

const tags = getEntryTags(note);
---

<BaseLayout title={`${note.data.title} · Shivang Pandya`} description={note.data.description ?? "TIL note"}>
	<section class="article-shell">
		<a class="back-link" href="/til/">
			<span aria-hidden="true">←</span>
			Back to TIL
		</a>

		<article class="article-card">
			<header class="article-header">
				<p class="eyebrow">Today I learned</p>
				<h1 class="article-title">{note.data.title}</h1>
				{note.data.description && <p class="page-copy">{note.data.description}</p>}
				<div class="meta-row">
					<span class="meta-pill">{dateFormatted}</span>
					{tags.map((tag) => (
						<a class="tag tag-link" href={getTagHref(tag)}>
							#{tag}
						</a>
					))}
				</div>
			</header>

			<div class="prose max-w-none">
				<Content />
			</div>
		</article>
	</section>
</BaseLayout>
