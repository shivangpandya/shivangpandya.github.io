---
import SocialList from "@/components/SocialList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const skills = [
	"Python",
	"Java",
	"Terraform",
	"Docker",
	"Kubernetes",
	"Linux",
	"Oracle Cloud (OCI)",
	"Amazon Web Services",
	"Microsoft Azure",
	"Oracle Integration Cloud",
	"REST APIs",
	"SOAP",
	"FBDI",
	"MS SQL Server",
	"MySQL",
	"PostgreSQL",
	"MongoDB",
	"Keras",
	"Flask",
	"Tableau",
	"JIRA",
	"Confluence",
];
---

<BaseLayout
	title="About · Shivang Pandya"
	description="Cloud Architect based in Austin, TX. 5 years of experience in OCI, AWS, enterprise migrations and integrations."
>
	<section class="section-card tone-sky">
		<div class="page-hero">
			<p class="eyebrow">About</p>
			<h1 class="page-title">Architecture, delivery, and the messy middle in between.</h1>
			<p class="page-copy">
				I'm Shivang Pandya, a cloud solutions architect based in Austin. My work sits at the intersection of architecture design, migration planning, enterprise integration, and helping teams move from diagrams to working systems.
			</p>
		</div>
	</section>

	<section class="two-column">
		<div class="section-card tone-sunset">
			<div class="section-head">
				<p class="eyebrow">Background</p>
				<h2 class="section-title">What I focus on</h2>
				<p class="section-copy">
					I work on Oracle Cloud Infrastructure engagements that need clear architecture thinking and practical execution. That usually means migration planning, integration patterns, workshops, and making tradeoffs legible for delivery teams.
				</p>
			</div>
			<div class="page-stack" style="gap: 1rem; margin-top: 1.4rem;">
				<p class="section-copy">
					My background also includes machine learning, APIs, and full-stack work, which helps when architecture conversations need to land in implementation details quickly.
				</p>
				<SocialList />
			</div>
		</div>

		<div class="section-card tone-mint">
			<div class="section-head">
				<p class="eyebrow">Toolbox</p>
				<h2 class="section-title">Skills and platforms</h2>
			</div>
			<div class="skill-cloud" style="margin-top: 1.4rem;">
				{skills.map((skill) => (
					<span class="skill-pill">{skill}</span>
				))}
			</div>
		</div>
	</section>

	<section class="section-card tone-ink">
		<div class="section-head">
			<p class="eyebrow">Experience</p>
		</div>

		<div class="timeline" style="margin-top: 1.4rem;">
			<div class="timeline-card">
				<div class="timeline-head">
					<div>
						<div class="timeline-role">Cloud Solutions Architect</div>
						<div class="timeline-company">Oracle · Enterprise Growth Team · Austin, TX</div>
					</div>
					<div class="meta-pill">Jul 2021 – Present</div>
				</div>
				<ul class="timeline-list">
					<li>Design end-to-end OCI architectures for enterprise customer challenges.</li>
					<li>Work across databases, FTP servers, SaaS apps, and integration workflows using REST, SOAP, and FBDI patterns.</li>
					<li>Support on-premise migrations with downtime planning and modernization decisions.</li>
					<li>Run workshops and technical sessions for enterprise cloud customers.</li>
				</ul>
			</div>

			<div class="timeline-card">
				<div class="timeline-head">
					<div>
						<div class="timeline-role">Technology Summer Analyst</div>
						<div class="timeline-company">Credit Suisse · New York, NY</div>
					</div>
					<div class="meta-pill">Jul 2020 – Aug 2020</div>
				</div>
				<ul class="timeline-list">
					<li>Built Python recommender tooling to improve sales team performance on structured products.</li>
					<li>Developed Keras models over client behavior data and exposed predictions through Flask APIs.</li>
					<li>Translated model work into practical decision support for the business.</li>
				</ul>
			</div>

			<div class="timeline-card">
				<div class="timeline-head">
					<div>
						<div class="timeline-role">Software Engineer Intern</div>
						<div class="timeline-company">Upnexo Technologies · Vadodara, India</div>
					</div>
					<div class="meta-pill">Nov 2017 – Jan 2018</div>
				</div>
				<ul class="timeline-list">
					<li>Researched migration from SQLite and CoreData to Realm and Firebase.</li>
					<li>Contributed to the Split Screen app for macOS used by more than 50,000 users.</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="two-column">
		<div class="section-card tone-sky">
			<div class="section-head">
				<p class="eyebrow">Education</p>
				<h2 class="section-title">Formal training</h2>
			</div>
			<div class="timeline" style="margin-top: 1.4rem;">
				<div class="timeline-card">
					<div class="timeline-head">
						<div>
							<div class="timeline-role">M.S. Computer Science</div>
							<div class="timeline-company">New York University</div>
						</div>
						<div class="meta-pill">2019 – 2021</div>
					</div>
				</div>
				<div class="timeline-card">
					<div class="timeline-head">
						<div>
							<div class="timeline-role">B.E. Information Technology</div>
							<div class="timeline-company">Gujarat Technological University</div>
						</div>
						<div class="meta-pill">2015 – 2019</div>
					</div>
				</div>
			</div>
		</div>

		<div class="cta-card">
			<div class="section-head">
				<p class="eyebrow">Let's connect</p>
			</div>
			<div style="margin-top: 0.2rem;">
				<SocialList variant="card" />
			</div>
		</div>
	</section>
</BaseLayout>
