---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
	title="Projects moved · Shivang Pandya"
	description="Projects has moved to the TIL section."
>
	<meta http-equiv="refresh" content="0; url=/til/" />

	<section class="section-card empty-state">
		<p class="eyebrow">Route update</p>
		<h1 class="page-title">Projects moved to TIL.</h1>
		<p class="page-copy" style="max-width: 32rem; margin: 0 auto;">
			That section now lives under your markdown-backed TIL archive.
		</p>
		<div class="hero-actions" style="justify-content: center;">
			<a class="button" href="/til/">Open TIL</a>
		</div>
	</section>

	<script>
		window.location.replace("/til/");
	</script>
</BaseLayout>
